# Simulated dashboard server, for exercising the gold DB deploy and rollback
# workflow without a real remote host. Development and testing only -- this
# image is never deployed anywhere.
#
# Built on the official alpine image plus Alpine's own signed openssh package.
# There is no Docker Official Image for an SSH server, so this is the shortest
# trust chain available: one official base, one distro-signed package, no
# third-party image layer.
#
# The login shell is busybox ash, not bash. That is deliberate -- it means a
# successful run also proves the deploy and rollback command strings are
# portable POSIX shell, which is what `ssh host "<command>"` actually hands to
# whatever login shell the real dashboard server uses.
FROM alpine:3

# PermitEmptyPasswords defaults to no and password auth is disabled below, so
# clearing the account lock is safe and keeps sshd from rejecting the account
# outright on some builds.
RUN apk add --no-cache openssh-server \
    && adduser -D -h /home/deployer deployer \
    && passwd -d deployer \
    && mkdir -p /srv/dashboard /home/deployer/.ssh \
    && chown -R deployer:deployer /srv/dashboard /home/deployer/.ssh \
    && chmod 700 /home/deployer/.ssh

RUN printf '%s\n' \
      '' \
      '# dashboard-sim: key-based auth only' \
      'PermitRootLogin no' \
      'PasswordAuthentication no' \
      'PermitEmptyPasswords no' \
      'PubkeyAuthentication yes' \
    >> /etc/ssh/sshd_config \
    && ssh-keygen -A \
    && /usr/sbin/sshd -t

EXPOSE 22

# authorized_keys is installed at startup rather than baked in, so the keypair
# can be regenerated without rebuilding the image.
CMD ["/bin/sh", "-c", "set -e; \
cp /keys/id_rsa.pub /home/deployer/.ssh/authorized_keys; \
chown deployer:deployer /home/deployer/.ssh/authorized_keys; \
chmod 600 /home/deployer/.ssh/authorized_keys; \
exec /usr/sbin/sshd -D -e"]
